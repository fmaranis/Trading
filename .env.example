# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MARKET_DATA_PROVIDER: Primary provider used for the broad market scan.
# Yahoo Finance currently requires no API key in this architecture.
MARKET_DATA_PROVIDER="yahoo_finance"

# MARKET_DATA_API_KEY: Optional generic server-side key for future providers.
MARKET_DATA_API_KEY="your_api_key_here"

# ALPHA_VANTAGE_API_KEY: Optional secondary provider key, server-side only.
# When configured, the app can cross-validate the final Yahoo shortlist.
# NEVER prefix with VITE_ and never expose this value in frontend code.
ALPHA_VANTAGE_API_KEY="your_alpha_vantage_api_key_here"

# EODHD_API_KEY: Preferred secondary REAL provider key, server-side only.
# Used to cross-validate Yahoo closes. Yahoo .DE tickers are mapped to EODHD .XETRA.
# NEVER prefix with VITE_ and never expose this value in frontend code.
EODHD_API_KEY="your_eodhd_api_key_here"

# MARKET_DATA_TIMEOUT_MS: Maximum timeout for upstream market data requests in milliseconds
MARKET_DATA_TIMEOUT_MS="10000"

# -----------------------------------------------------------------------------
# FIREBASE AUTH + PRIVATE USER DATA
# -----------------------------------------------------------------------------
# Public Firebase web configuration. The web API key is configuration, not an admin credential.
# It is returned at runtime by /api/alerts/account/public-config so the same build can move between environments.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_WEB_API_KEY="your-firebase-web-api-key"
FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
FIREBASE_APP_ID="your-firebase-web-app-id"

# Production always requires authentication. In local/AI Studio development, setting this to true
# also disables the temporary private-development bypass before deployment.
FIREBASE_AUTH_REQUIRED="false"

# true: a visitor may create a Firebase account, but it remains PENDING until an admin grants access.
# false: only an admin can create accounts from the private account-management panel.
# Recommended for a closed pilot: false.
FIREBASE_SELF_REGISTRATION_ENABLED="true"

# Initial administrator bootstrap. Configure at least one exact email or UID BEFORE publishing.
# EMAIL bootstrap is accepted ONLY after Firebase says email_verified=true; an unverified account
# cannot gain ADMIN merely by registering the configured address. UID bootstrap is exact by definition.
# On successful bootstrap the backend sets signed custom claims: isAdmin=true + accessGranted=true.
# Comma-separated values are supported. Remove bootstrap values after stable admins exist.
FIREBASE_BOOTSTRAP_ADMIN_EMAILS=""
FIREBASE_BOOTSTRAP_ADMIN_UIDS=""

# Cloud Run should use Application Default Credentials / its service account, so this is normally blank.
# For local or AI Studio server execution outside the target GCP project, an optional service-account JSON
# may be supplied as ONE server-side secret. NEVER expose it with VITE_ or commit a real value.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Historical replay publication for direct ChatGPT inspection (development/AI Studio only).
# Create a fine-grained GitHub token scoped ONLY to fmaranis/Trading with Contents: Read and write,
# and configure it as a server-side/AI Studio secret. NEVER prefix it with VITE_ and never paste it into frontend code.
# Saving a replay then publishes the compact canonical copy to replay-results/validation-runs/latest-chatgpt.json.
# Production publication is deliberately blocked until a proper authenticated admin path exists.
GITHUB_REPLAY_SYNC_TOKEN=""
GITHUB_REPLAY_SYNC_REPOSITORY="fmaranis/Trading"
GITHUB_REPLAY_SYNC_BRANCH="replay-results"

# Autonomous opportunity alerts. Disabled by default.
# In AI Studio Preview this only runs while that server is alive.
# For 24/7 operation deploy the app and invoke POST /api/alerts/run-now on a reliable daily scheduler.
# The built-in timer remains useful for local/long-lived-server testing but is not the production scheduler contract.
ALERT_AUTOMATION_ENABLED="false"
ALERT_RUN_TIME_LOCAL="22:30"
ALERT_CASH_BENCHMARK_PCT="2.5"
ALERT_CAPITAL_EUR="1000"
ALERT_RISK_PROFILE="MEDIUM"
ALERT_HORIZON_YEARS="3"

# Optional server-only webhook receiving a JSON payload ONLY for a new GOOD_ENTRY
# or escalation from GOOD_ENTRY to HIGH_CONVICTION. Repeated unchanged opportunities stay silent.
# Keep this secret server-side; it is also included in response redaction.
ALERT_WEBHOOK_URL=""

# Protects POST /api/alerts/run-now in production. Use a long random secret.
# A production scheduler may supply this value in x-alert-admin-token.
# Never expose it to frontend code. Development can run the endpoint without this token.
ALERT_ADMIN_TOKEN=""

# Optional internal base URL used by the alert job to call this app's market-data/EODHD routes.
# Local development defaults to http://127.0.0.1:3000 when omitted.
ALERT_INTERNAL_BASE_URL=""

# IMPORTANT FOR CLOUD RUN / OTHER EPHEMERAL CONTAINERS:
# .runtime/alertAutomationState.json is intentionally a local runtime cache, not durable storage.
# The authenticated portfolio/state is now prepared for Firestore under users/{uid}/private/state.
# The autonomous alert dedupe state is still a local runtime cache until the scheduler is migrated to Firestore.
