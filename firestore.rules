rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.isAdmin == true;
    }

    function hasAccess() {
      return signedIn() && (request.auth.token.accessGranted == true || isAdmin());
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Profile/account metadata may be read by its owner or an account administrator.
    // Client writes are deliberately forbidden: role/access/status are server-managed.
    match /users/{userId} {
      allow read: if owns(userId) || isAdmin();
      allow create, update, delete: if false;

      // Financial data remains private even from account administrators.
      // ADMIN manages identity/access, not somebody else's money.
      match /private/{document=**} {
        allow read: if hasAccess() && owns(userId);
        allow create, update, delete: if false;
      }
    }

    // No other client-accessible collections are public by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
